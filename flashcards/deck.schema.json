{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aws-saa-flashcards/deck.schema.json",
  "title": "Flashcard deck for one AWS SAA-C03 topic guide section",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deck", "cards"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "title", "sourceFile", "subtopics"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "e.g. '01-iam'" },
        "section": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "sourceFile": { "type": "string", "description": "e.g. 'topic-guides/01-IAM.md'" },
        "analogy": { "type": ["string", "null"], "description": "The section's anchor analogy from 'The idea', one sentence" },
        "subtopics": {
          "type": "array",
          "description": "One entry per '## ' heading (excluding 'The idea', 'Question patterns', 'Pocket card')",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "title": { "type": "string" }
            }
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "subtopic", "front", "back", "difficulty", "tags", "sourceHeading"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+-[0-9]{3}$", "description": "deck prefix + 3-digit counter, e.g. 'iam-001'" },
          "type": {
            "enum": ["concept", "compare", "trap", "scenario", "signal", "fact"],
            "description": "concept=what/why; compare=A vs B; trap=common wrong answer; scenario=exam question→answer; signal=keyword→service (pocket card); fact=number/limit/default"
          },
          "subtopic": { "type": "string", "description": "Must match a deck.subtopics[].id, or 'patterns' / 'pocket-card'" },
          "front": { "type": "string", "description": "Question/prompt. Markdown allowed (bold, inline code, code blocks)." },
          "back": {
            "type": "object",
            "additionalProperties": false,
            "required": ["answer"],
            "properties": {
              "answer": { "type": "string", "description": "Short, direct answer (≤ ~25 words). Markdown allowed." },
              "explanation": { "type": ["string", "null"], "description": "1–3 sentences of why, taken from the notes." },
              "mnemonic": { "type": ["string", "null"], "description": "Analogy hook from the notes (e.g. 'role = temporary costume')." },
              "code": { "type": ["string", "null"], "description": "Optional snippet (policy JSON, CLI) shown monospaced." }
            }
          },
          "choices": {
            "type": ["array", "null"],
            "description": "Optional multiple-choice mode (scenario/trap cards). Exactly one correct.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "correct"],
              "properties": {
                "text": { "type": "string" },
                "correct": { "type": "boolean" },
                "why": { "type": ["string", "null"], "description": "Why this option is right/wrong" }
              }
            }
          },
          "difficulty": { "enum": [1, 2, 3], "description": "1=recall, 2=understand/compare, 3=apply to scenario" },
          "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "sourceHeading": { "type": "string", "description": "Exact '## ' heading text the card came from" },
          "examTip": { "type": ["string", "null"], "description": "The tell-tale keyword/signal, if any" }
        }
      }
    }
  }
}
